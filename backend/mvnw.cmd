@rem If you want to use a specific Maven version, modify the value of
@rem MAVEN_VERSION below. The default version is the one used to generate
@rem this wrapper.
set "MAVEN_VERSION=3.9.6"

@rem If you want to use a specific distribution URL, modify the value of
@rem MAVEN_DISTRIBUTION_URL below.
set "MAVEN_DISTRIBUTION_URL=https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/%MAVEN_VERSION%/apache-maven-%MAVEN_VERSION%-bin.zip"

@rem If you want to use a specific wrapper JAR, modify the value of
@rem WRAPPER_JAR below.
set "WRAPPER_JAR=.mvn\wrapper\maven-wrapper.jar"

@rem If you want to use a specific wrapper properties file, modify the value of
@rem WRAPPER_PROPERTIES below.
set "WRAPPER_PROPERTIES=.mvn\wrapper\maven-wrapper.properties"

@rem Resolve the directory containing this script.
set "BASEDIR=%~dp0"
if not "%BASEDIR%"=="" set "BASEDIR=%BASEDIR:~0,-1%"

@rem If the wrapper JAR does not exist, download it.
if not exist "%BASEDIR%\%WRAPPER_JAR%" (
    mkdir "%BASEDIR%\.mvn\wrapper" 2>nul
    echo Downloading Maven wrapper JAR...
    powershell -Command "& { try { Invoke-WebRequest -Uri '%MAVEN_DISTRIBUTION_URL%' -OutFile '%BASEDIR%\%WRAPPER_JAR%' } catch { Write-Error 'Failed to download Maven wrapper JAR'; exit 1 } }"
    if errorlevel 1 (
        echo Error: Failed to download Maven wrapper JAR.
        exit /b 1
    )
)

@rem Execute Maven
java -Dmaven.multiModuleProjectDirectory="%BASEDIR%" -cp "%BASEDIR%\%WRAPPER_JAR%" org.apache.maven.wrapper.MavenWrapperMain %*