# If you want to use a specific Maven version, modify the value of
# MAVEN_VERSION below. The default version is the one used to generate
# this wrapper.
MAVEN_VERSION=3.9.6

# If you want to use a specific distribution URL, modify the value of
# MAVEN_DISTRIBUTION_URL below.
MAVEN_DISTRIBUTION_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.zip"

# If you want to use a specific wrapper JAR, modify the value of
# WRAPPER_JAR below.
WRAPPER_JAR=".mvn/wrapper/maven-wrapper.jar"

# If you want to use a specific wrapper properties file, modify the value of
# WRAPPER_PROPERTIES below.
WRAPPER_PROPERTIES=".mvn/wrapper/maven-wrapper.properties"

# Resolve the directory containing this script.
PRG="$0"
while [ -h "$PRG" ] ; do
    ls=`ls -ld "$PRG"`
    link=`expr "$ls" : '.*-> \(.*\)$'`
    if expr "$link" : '/.*' > /dev/null; then
        PRG="$link"
    else
        PRG="`dirname "$PRG"`/$link"
    fi
done
SAVED="`pwd`"
cd "`dirname \"$PRG\"`" >/dev/null
BASEDIR="`pwd`"
cd "$SAVED" >/dev/null

# If the wrapper JAR does not exist, download it.
if [ ! -f "$BASEDIR/$WRAPPER_JAR" ]; then
    mkdir -p "`dirname \"$BASEDIR/$WRAPPER_JAR\"`"
    echo "Downloading Maven wrapper JAR..."
    if command -v curl >/dev/null 2>&1; then
        curl -f -L -o "$BASEDIR/$WRAPPER_JAR" "$MAVEN_DISTRIBUTION_URL" 2>/dev/null || curl -f -L -o "$BASEDIR/$WRAPPER_JAR" "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.zip" 2>/dev/null
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O "$BASEDIR/$WRAPPER_JAR" "$MAVEN_DISTRIBUTION_URL" 2>/dev/null || wget -q -O "$BASEDIR/$WRAPPER_JAR" "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.zip" 2>/dev/null
    else
        echo "Error: Neither curl nor wget found. Cannot download Maven wrapper."
        exit 1
    fi
fi

# Execute Maven
exec java -cp "$BASEDIR/$WRAPPER_JAR" org.apache.maven.wrapper.MavenWrapperMain "$@"